# TypeSafe AI (Jev) — used by api/contact.js to classify inbound contact
# messages for spam and lead quality. Get a key at https://typesafe.ai.
#
# Optional: if this is unset, or @typesafe-ai/sdk isn't installed, the
# contact form still works — it just skips the Jev classification step.
TYPESAFE_API_KEY=
